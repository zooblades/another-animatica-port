{
  "schemaVersion": 1,
  "id": "animatica",
  "version": "${version}",
  "name": "Animatica",
  "description": "Allow for animating more game textures using the MCPatcher/OptiFine animation format",
  "authors": [
    "nazarbatrider"
  ],
  "contact": {
    "homepage": "https://github.com/FoundationGames/Animatica",
    "sources": "https://github.com/zooblades/another-animatica-port"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/animatica/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.foundationgames.animatica.Animatica"
    ]
  },
  "mixins": [
    "animatica.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "contributors": [
    "FoundationGames (author of the original Animatica mod)"
  ]
}
